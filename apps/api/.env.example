# Runtime: use the pooled/serverless connection from Neon/Vercel Marketplace.
DATABASE_URL="postgresql://user:password@host-pooler.example/db?sslmode=require"
# Optional direct URL for migrations. Neon commonly exposes DATABASE_URL_UNPOOLED.
DATABASE_URL_UNPOOLED="postgresql://user:password@host.example/db?sslmode=require"
# DIRECT_URL can be used instead of DATABASE_URL_UNPOOLED.
DIRECT_URL=""
PORT=4000
NODE_ENV=development
JWT_SECRET="replace-with-a-long-random-string"
CRON_SECRET="replace-with-a-second-long-random-string"
TELEGRAM_BOT_TOKEN="123456789:replace_with_botfather_token"
TELEGRAM_WEBHOOK_SECRET="replace-with-another-random-string"
MINI_APP_URL="http://localhost:5173"
# Optional. On Vercel the API normally shares MINI_APP_URL and stays under /api.
# PUBLIC_API_URL="https://your-custom-domain.example"
ADMIN_TELEGRAM_IDS="111111111"
ADMIN_CONTACT="@poker_club74_admin"
CLUB_TIMEZONE="Asia/Yekaterinburg"
CLOUDINARY_CLOUD_NAME="replace-with-cloud-name"
CLOUDINARY_API_KEY="replace-with-api-key"
CLOUDINARY_API_SECRET="replace-with-new-rotated-api-secret"
GOOGLE_SERVICE_ACCOUNT_EMAIL="poker-sheets@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
ALLOW_DEV_AUTH=true
